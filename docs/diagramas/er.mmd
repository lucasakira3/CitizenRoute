---
title: "Banco Oracle do Citizen Life: 6 tabelas"
---
erDiagram
    CL_CIDADAO ||--o{ CL_ROTA : "salva"
    CL_CIDADAO ||--o{ CL_ENDERECO : "guarda"
    CL_ROTA ||--|{ CL_ROTA_VIA : "passa por"
    CL_VIA ||--o{ CL_ROTA_VIA : "faz parte de"
    CL_VIA ||--o{ CL_OCORRENCIA : "tem"

    CL_CIDADAO {
        NUMBER id_cidadao PK
        VARCHAR2 nome
        VARCHAR2 email UK
        VARCHAR2 senha_hash
        VARCHAR2 modal "CHECK, opcional"
        DATE dt_cadastro
    }
    CL_ROTA {
        NUMBER id_rota PK
        NUMBER id_cidadao FK
        VARCHAR2 nome "UK com id_cidadao"
        VARCHAR2 origem_descricao
        NUMBER origem_x
        NUMBER origem_y
        VARCHAR2 destino_descricao
        NUMBER destino_x
        NUMBER destino_y
        NUMBER distancia_m
        DATE dt_criacao
    }
    CL_ROTA_VIA {
        NUMBER id_rota PK,FK
        NUMBER id_via PK,FK
        NUMBER ordem
    }
    CL_VIA {
        NUMBER id_via PK
        VARCHAR2 nome UK
        VARCHAR2 zona "CHECK"
    }
    CL_OCORRENCIA {
        NUMBER id_ocorrencia PK
        NUMBER id_via FK
        VARCHAR2 titulo UK
        VARCHAR2 descricao
        VARCHAR2 tipo "CHECK"
        NUMBER gravidade "1 a 5"
        DATE dt_registro
    }
    CL_ENDERECO {
        NUMBER id_endereco PK
        NUMBER id_cidadao FK
        VARCHAR2 apelido "UK com id_cidadao"
        VARCHAR2 tipo "CHECK"
        VARCHAR2 descricao
        NUMBER pos_x
        NUMBER pos_y
    }
