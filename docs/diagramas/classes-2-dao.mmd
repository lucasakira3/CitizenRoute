---
title: "dao: acesso ao Oracle com JDBC"
---
classDiagram
    direction TB
    class CrudDao~T~ {
        <<interface>>
        +inserir(T) T
        +listar() List~T~
        +buscarPorId(long) Optional~T~
        +atualizar(T) boolean
        +excluir(long) boolean
    }
    class CidadaoDao {
        +buscarPorEmail(String) Optional~Cidadao~
    }
    class RotaDao {
        +listarPorCidadao(long) List~Rota~
        +listarVias() List~Via~
    }
    class EnderecoDao {
        +listarPorCidadao(long) List~Endereco~
    }
    class OcorrenciaDao {
        +listar() List~Ocorrencia~
    }
    class Conexao {
        <<final>>
        +abrir()$ Connection
        +traduzir(SQLException, String acao)$ CitizenLifeException
        +testar()$ String
    }
    CrudDao <|.. CidadaoDao : T = Cidadao
    CrudDao <|.. RotaDao : T = Rota
    CrudDao <|.. EnderecoDao : T = Endereco
    CidadaoDao ..> Conexao
    RotaDao ..> Conexao
    EnderecoDao ..> Conexao
    OcorrenciaDao ..> Conexao
