---
title: "model: os dados do sistema (getters e setters omitidos)"
---
classDiagram
    direction LR
    class Cidadao {
        +String MODAL_PADRAO$
        -Long id
        -String nome
        -String email
        -String senhaHash
        -String modal
        -LocalDateTime dataCadastro
        +modalParaRisco() String
    }
    class Rota {
        -Long id
        -Long idCidadao
        -String nome
        -String origemDescricao
        -double origemX
        -double origemY
        -String destinoDescricao
        -double destinoX
        -double destinoY
        -int distanciaMetros
        -LocalDateTime dataCriacao
        -List~Via~ vias
        +passaPor(Long idVia) boolean
    }
    class Via {
        -Long id
        -String nome
        -String zona
    }
    class Endereco {
        +List~String~ TIPOS$
        -Long id
        -Long idCidadao
        -String apelido
        -String tipo
        -String descricao
        -double x
        -double y
        +isTipoUnico() boolean
    }
    class Ocorrencia {
        +List~String~ MODAIS$
        +double LIMITE_ALERTA$
        -Long id
        -String titulo
        -String descricao
        -String tipo
        -int gravidade
        -LocalDateTime dataRegistro
        -Via via
        +calcularRisco(String modal) double
        +nivel(double risco)$ String
    }
    Cidadao "1" --> "0..10" Rota : salva
    Cidadao "1" --> "0..10" Endereco : guarda
    Rota "*" --> "1..*" Via : passa por
    Ocorrencia "*" --> "1" Via : acontece em
